{
  "name": "project-manage",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "vite --config apps/web/vite.config.ts",
    "dev:api": "tsx watch apps/api/src/index.ts",
    "dev:all": "concurrently -k -n api,web 'npm:dev:api' 'npm:dev'",
    "build": "npm run typecheck && vite build --config apps/web/vite.config.ts && tsc -p tsconfig.server.json",
    "start": "node dist/server/apps/api/src/index.js",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate": "tsx apps/api/src/cli.ts migrate",
    "db:backup": "tsx apps/api/src/backup-cli.ts",
    "check:entry": "tsx apps/api/src/check-entry.ts",
    "db:seed": "tsx apps/api/src/cli.ts seed",
    "user:create": "tsx apps/api/src/cli.ts user",
    "user:reset-password": "tsx apps/api/src/reset-password.ts",
    "setup:local": "tsx scripts/setup-local.ts",
    "test:runtime": "npm run build && node scripts/smoke-built.mjs",
    "format:check": "prettier --check apps packages tests scripts *.ts *.js *.json",
    "admin:grant": "tsx apps/api/src/grant-admin.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/helmet": "13.1.2",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/static": "10.1.6",
    "@fontsource/inter": "5.3.0",
    "@phosphor-icons/vue": "2.2.1",
    "dotenv": "18.0.7",
    "fastify": "5.12.5",
    "pinia": "4.0.3",
    "read-excel-file": "9.3.12",
    "vue": "3.5.43",
    "vue-router": "5.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@types/node": "26.6.5",
    "@vitejs/plugin-vue": "6.0.10",
    "concurrently": "10.0.6",
    "eslint": "10.12.0",
    "eslint-plugin-vue": "10.11.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.3",
    "vue-tsc": "3.3.13"
  }
}
