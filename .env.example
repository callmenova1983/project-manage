# Copy to .env and fill the database settings before any setup/start command.
# Keep each server's private configuration outside the release checkout.
HOST=127.0.0.1
PORT=3001
DB_TYPE=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=pm-system
DB_USERNAME=pm-system
DB_PASSWORD=
DB_SCHEMA=public
DB_SSL=false
# Optional trusted CA file when DB_SSL=true; never disable certificate checks.
DB_SSL_CA_FILE=
# Keep the original key when migrating SQLite; use a persistent mounted path.
CREDENTIAL_KEY_PATH=./data/credentials.key
APP_ORIGIN=http://localhost:4173
# Set APP_ORIGIN to the exact browser scheme + hostname + optional port.
# For forwarded HTTPS URLs, use their origin, never /projects or another page path.
# Restart the API after changing it; exported environment values override .env.
# Only for the confirmed Codespaces Origin rewrite: explicit opt-in, matching
# CODESPACES/CODESPACE_NAME/PORT and a loopback HOST are required.
# See docs/origin-troubleshooting.md; never enable for arbitrary reverse proxies.
CODESPACES_ORIGIN_REWRITE=0
ORIGIN_DIAGNOSTICS=0
NODE_ENV=development
# Production: set NODE_ENV=production and APP_ORIGIN to the HTTPS origin.
# No default password. PM_USER_EMAIL, PM_USER_NAME, PM_USER_PASSWORD are CLI-only.
# VITE_DEMO_MODE=1 enables isolated browser-local demo storage (no authentication).

# Server-only Qwen: disabled by default. See docs/qwen-integration.md.
AI_PROVIDER=disabled
# Structured model runtime: legacy (rollback/default) or sdk (opt-in verification).
AI_RUNTIME=legacy
AI_CALLS_ENABLED=false
QWEN_MODEL=qwen3.6-35b-a3b
# Supply a console-verified region and matching Base URL; no region is assumed.
QWEN_REGION=
QWEN_BASE_URL=
# Inject a rotated key via the server secret manager, never a VITE_* variable.
DASHSCOPE_API_KEY=
# Enable only after an approved finite test allowance and expiry are recorded.
AI_BUDGET_ID=
AI_MAX_REQUESTS=
AI_BUDGET_EXPIRES_AT=
AI_TIMEOUT_MS=15000
AI_MAX_OUTPUT_TOKENS=2048
AI_MAX_RETRIES=0

# Server-only enterprise directory. Limit sync to one explicitly configured workspace.
# Requires an app secret with access to department/list and user/list.
WECOM_CORP_ID=
WECOM_CONTACT_SECRET=
WECOM_WORKSPACE_ID=

# Server-only initial password for newly provisioned accounts. Existing passwords are not reset.
PM_DEFAULT_USER_PASSWORD=

# Explicit extra browser origins, comma-separated; no wildcards.
APP_ADDITIONAL_ORIGINS=

# Performance rollout. VITE_* flags are baked into the frontend build.
VITE_WORKSPACE_CORE=1
VITE_WORKSPACE_SSE=1
PM_SSE=1
# Opt in only after the compatible backend migration is installed.
# All API instances must use the same mode; 0 retains synchronous derivation.
PM_BACKGROUND_NOTIFICATIONS=0
PM_PERFORMANCE_LOG=0
