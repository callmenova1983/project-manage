# Copy to .env after npm run setup:local, or provision your own account via user:create.
HOST=127.0.0.1
PORT=3001
DATABASE_PATH=./data/project-manage.sqlite
APP_ORIGIN=http://localhost:4173
NODE_ENV=development
# Production: set NODE_ENV=production and APP_ORIGIN to the HTTPS origin.
# No default password. PM_USER_EMAIL, PM_USER_NAME, PM_USER_PASSWORD are CLI-only.
# VITE_DEMO_MODE=1 enables isolated browser-local demo storage (no authentication).

# Server-only Qwen: disabled by default. See docs/qwen-integration.md.
AI_PROVIDER=rules
AI_CALLS_ENABLED=false
QWEN_MODEL=qwen3.6-35b-a3b
# Supply a console-verified region and matching Base URL; no region is assumed.
QWEN_REGION=
QWEN_BASE_URL=
# Inject a rotated key via the server secret manager, never a VITE_* variable.
DASHSCOPE_API_KEY=
# Enable only after an approved finite test allowance and expiry are recorded.
AI_BUDGET_ID=
AI_MAX_REQUESTS=
AI_BUDGET_EXPIRES_AT=
AI_TIMEOUT_MS=15000
AI_MAX_OUTPUT_TOKENS=2048
AI_MAX_RETRIES=0
